<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/me-dfs#"
     xml:base="http://www.semanticweb.org/me-dfs"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/me-dfs">
        <rdfs:comment xml:lang="en">M&amp;E Design-for-Safety ontology. TBox generated from the NVivo codebook and the 13 July diagram framework. Change the base IRI to your own before publishing.</rdfs:comment>
    </owl:Ontology>
    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/me-dfs#provisional"><rdfs:label>provisional</rdfs:label><rdfs:comment>True for empty (0/0) NVivo nodes kept as placeholders.</rdfs:comment></owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/me-dfs#hocRank"><rdfs:label>hocRank</rdfs:label><rdfs:comment>Hierarchy-of-Control rank: 1=Elimination (most effective) ... 5=PPE.</rdfs:comment></owl:AnnotationProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#part_of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#DesignComponent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#MESystem"/>
        <rdfs:label>is part of</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#requires">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#DesignComponent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#Activity"/>
        <rdfs:label>requires</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#compliesWith">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#DesignComponent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#Regulation"/>
        <rdfs:label>complies with</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#predisposes">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#DesignComponent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#DesignRisk"/>
        <rdfs:label>predisposes (latent)</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#gives_rise_to">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#Activity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#DesignRisk"/>
        <rdfs:label>gives rise to</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#performed_in">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#Activity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#Space"/>
        <rdfs:label>performed in</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#performed_during">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#Activity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#Lifecycle"/>
        <rdfs:label>performed during</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#performed_by">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#Activity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#Stakeholder"/>
        <rdfs:label>performed by</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#mitigated_by">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#DesignRisk"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#Control"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/me-dfs#mitigates"/>
        <rdfs:label>mitigated by</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#mitigates">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#Control"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#DesignRisk"/>
        <rdfs:label>mitigates</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#recommended_by">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#Control"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#DfSRules"/>
        <rdfs:label>recommended by</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#deficiencyCreates">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#DesignDeficiency"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#HazardSource"/>
        <rdfs:label>deficiency creates</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#hazardLeadsTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#HazardSource"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#AccidentType"/>
        <rdfs:label>hazard leads to</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/me-dfs#leavesResidualRisk">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/me-dfs#Control"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/me-dfs#ResidualRisk"/>
        <rdfs:label>leaves residual risk</rdfs:label>
    </owl:ObjectProperty>
